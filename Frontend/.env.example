# Empty uses the Vite proxy to localhost:4000.
VITE_HYPERTRON_API_URL=
# Used for Explorer links and Phantom cluster copy.
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
# Empty uses the Vite /idx proxy to localhost:4002.
VITE_INDEXER_URL=
VITE_INDEXER_NETWORK=devnet
# Optional CDN for proving keys / WASM (defaults to this origin /keys and /wasm).
VITE_KEYS_BASE_URL=
VITE_WASM_BASE_URL=
