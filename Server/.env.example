PORT=4000
DATABASE_URL="postgresql://localhost:5432/hypertron_server?schema=public"

# Comma-separated origins for the dashboard/frontend. Empty means allow all (dev only).
CORS_ORIGINS=

# bcrypt cost for API key secrets.
API_KEY_SALT_ROUNDS=12

# Private settlement backend. "mock" until the Solana/Anchor pool lands.
SETTLEMENT_PROVIDER=mock
# Simulated settlement latency in ms, so the demo shows a real async lifecycle.
SETTLEMENT_LATENCY_MS=1500
