PORT=4000
DATABASE_URL="postgresql://localhost:5432/hypertron_server?schema=public"

# Comma-separated origins for the dashboard/frontend. Empty means localhost:5173.
CORS_ORIGINS=http://localhost:5173

# Public origin used when minting payment-link URLs.
PUBLIC_APP_URL=http://localhost:5173

# bcrypt cost for API key secrets.
API_KEY_SALT_ROUNDS=12

SESSION_SECRET=hypertron-dev-session-secret
# HTTPS dashboard on another host (Render) needs Secure + SameSite=None.
# Local: omit these (defaults to Secure=false, SameSite=lax).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.hypertron.xyz

# Private settlement backend: "mock" or "pool" (hypertron_pool on Solana).
SETTLEMENT_PROVIDER=mock
# Simulated settlement latency in ms (mock only).
SETTLEMENT_LATENCY_MS=1500

# --- hypertron_pool (used when SETTLEMENT_PROVIDER=pool) ---
# Local demo talks to the live Solana devnet pool (not 127.0.0.1:8899).
SOLANA_RPC_URL=https://api.devnet.solana.com
# File path, JSON secret array, base64 of id.json, or base58. Render: paste id.json contents.
SOLANA_RELAYER_KEYPAIR=~/.config/solana/id.json
POOL_PROGRAM_ID=9HQsgGDHgYw3N8PGnh9EWrUGRHgmp7tmdGaxuBHHA335
# localnet | devnet | mainnet — derived from SOLANA_RPC_URL if unset
POOL_NETWORK=devnet
# Circle USDC on Solana devnet (customers must hold this; Nest will not mint).
POOL_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Proving keys from `scripts/pool-dev-keys.sh`
POOL_KEYS_DIR=../keys
POOL_PROVE_BIN=hypertron-prove
# Optional. If empty, Server writes keys/spend.sk on first settle.
POOL_SPEND_SK=
# After a shield deposit, unshield to the merchant/payee ATA.
# Default off — instant unshield links deposit amount to payout.
POOL_AUTO_UNSHIELD=false
# Seconds a paid invoice must sit in-pool before Withdraw is enabled.
POOL_WITHDRAW_DELAY_SEC=60
# Snap invoice amounts up to these mint minor-unit buckets.
POOL_AMOUNT_BUCKETS=100000,500000,1000000,5000000,10000000
POOL_INDEXER_URL=http://127.0.0.1:4002
# Relayer waits this long (or until N proofs) before submitting exits.
POOL_RELAY_INTERVAL_MS=15000
POOL_RELAY_BATCH_SIZE=8
