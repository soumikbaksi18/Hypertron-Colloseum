# Paste into Render Blueprint secrets. Do not use Atlas Mongo or api.hypertron.xyz.
# After funding the relayer on devnet, run: ./scripts/devnet-up.sh

# --- Shared chain ---
SOLANA_RPC_URL=https://api.devnet.solana.com
# Prefer a Helius (or similar) devnet URL in production so the indexer is not rate-limited.
POOL_PROGRAM_ID=9HQsgGDHgYw3N8PGnh9EWrUGRHgmp7tmdGaxuBHHA335
POOL_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
POOL_NETWORK=devnet
# Relayer / upgrade authority pubkey: 6XByMfCK5gLmNegcosDgtd3cY84uRANKttuTh4qJo1Nk
# SOLANA_RELAYER_KEYPAIR=<paste the JSON array from ~/.config/solana/id.json>

# --- hypertron-colosseum-api ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
CORS_ORIGINS=https://YOUR-FRONTEND.onrender.com
PUBLIC_APP_URL=https://YOUR-FRONTEND.onrender.com
POOL_INDEXER_URL=https://YOUR-INDEXER.onrender.com
COOKIE_SECURE=true
COOKIE_SAMESITE=none
SETTLEMENT_PROVIDER=pool
POOL_AUTO_UNSHIELD=false
POOL_WITHDRAW_DELAY_SEC=3600
SESSION_SECRET=<generate>

# --- hypertron-colosseum-indexer ---
INDEXER_DATA_DIR=/var/data
# CORS_ORIGINS= same as frontend
# SOLANA_RPC_URL / POOL_PROGRAM_ID same as api

# --- hypertron-colosseum-web (build-time Vite) ---
VITE_HYPERTRON_API_URL=https://YOUR-API.onrender.com
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_INDEXER_URL=https://YOUR-INDEXER.onrender.com
VITE_INDEXER_NETWORK=devnet

# Phantom: Devnet. Invoice USDC mint is POOL_MINT above.
# Fund relayer: https://faucet.solana.com  (devnet faucet via CLI is often rate-limited)
